{
  "name": "@gernst/bootstrap",
  "description": "Fork maintained of Bootstrap 4, modernized for Dart Sass 2, jQuery 4 and Popper 2.",
  "version": "4.7.0-dev",
  "config": {
    "version_short": "4.7"
  },
  "keywords": [
    "css",
    "sass",
    "mobile-first",
    "responsive",
    "front-end",
    "framework",
    "web"
  ],
  "homepage": "https://github.com/guillaume-ernst/bootstrap#readme",
  "author": "Guillaume Ernst",
  "contributors": [
    "The Bootstrap Authors (https://github.com/twbs/bootstrap/graphs/contributors)",
    "Twitter, Inc."
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaume-ernst/bootstrap.git"
  },
  "bugs": {
    "url": "https://github.com/guillaume-ernst/bootstrap/issues"
  },
  "main": "dist/js/bootstrap.js",
  "module": "dist/js/bootstrap.esm.js",
  "sass": "scss/bootstrap.scss",
  "style": "dist/css/bootstrap.css",
  "exports": {
    ".": {
      "style": "./dist/css/bootstrap.css",
      "sass": "./scss/bootstrap.scss",
      "import": {
        "default": "./dist/js/bootstrap.esm.js"
      },
      "require": {
        "default": "./dist/js/bootstrap.js"
      },
      "default": "./dist/js/bootstrap.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./scss/*": "./scss/*",
    "./scss": "./scss/bootstrap.scss",
    "./scss/module": "./scss/module/bootstrap.scss",
    "./scss/module/bootstrap-grid": "./scss/module/bootstrap-grid.scss",
    "./scss/module/bootstrap-reboot": "./scss/module/bootstrap-reboot.scss",
    "./js/*": "./js/*",
    "./js": "./js/index.js"
  },
  "sideEffects": [
    "dist/**/*.js",
    "js/dist/**/*.js",
    "js/src/**/*.js"
  ],
  "scripts": {
    "start": "npm run watch",
    "bundlewatch": "bundlewatch --config .bundlewatch.config.json",
    "css": "npm-run-all2 --aggregate-output --parallel css-lint css-compile css-prefix css-minify",
    "css-compile": "sass --style=expanded --source-map --embed-sources scss/:dist/css/",
    "css-lint": "npm-run-all2 --aggregate-output --continue-on-error --parallel css-lint-stylelint css-lint-vars",
    "css-lint-stylelint": "stylelint \"scss/**/*.{css,scss}\" --cache --cache-location .cache/.stylelintcache --rd",
    "css-lint-vars": "fusv scss/",
    "css-minify": "cleancss -O1 --format breakWith=lf --with-rebase --source-map --source-map-inline-sources --output dist/css/ --batch --batch-suffix \".min\" \"dist/css/*.css\" \"!dist/css/*.min.css\"",
    "css-prefix": "postcss --config build/postcss.config.js --replace \"dist/css/*.css\" \"!dist/css/*.min.css\"",
    "css-golden-check": "node build/css-golden-check.js",
    "css-module-check": "node build/css-module-check.js",
    "js": "npm-run-all2 --aggregate-output --parallel js-compile js-minify",
    "js-compile": "npm-run-all2 --aggregate-output --parallel js-compile-*",
    "js-compile-standalone": "rollup --environment BUNDLE:false --config build/rollup.config.js --sourcemap",
    "js-compile-bundle": "rollup --environment BUNDLE:true --config build/rollup.config.js --sourcemap",
    "js-compile-plugins": "node build/build-plugins.js",
    "js-lint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives .",
    "js-minify": "npm-run-all2 --aggregate-output --parallel js-minify-*",
    "js-minify-standalone": "terser --compress passes=2,typeofs=false --mangle --comments \"/^!/\" --source-map \"content=dist/js/bootstrap.js.map,includeSources,url=bootstrap.min.js.map\" --output dist/js/bootstrap.min.js dist/js/bootstrap.js",
    "js-minify-bundle": "terser --compress passes=2,typeofs=false --mangle --comments \"/^!/\" --source-map \"content=dist/js/bootstrap.bundle.js.map,includeSources,url=bootstrap.bundle.min.js.map\" --output dist/js/bootstrap.bundle.min.js dist/js/bootstrap.bundle.js",
    "test": "npm-run-all2 --aggregate-output --parallel test:unit test:sass test:e2e test:golden",
    "test:unit": "vitest run",
    "test:sass": "vitest run tests/sass",
    "test:e2e": "playwright test",
    "test:golden": "npm-run-all2 --parallel css-golden-check css-module-check",
    "lint": "npm-run-all2 --aggregate-output --continue-on-error --parallel js-lint css-lint lockfile-lint",
    "lockfile-lint": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "release": "npm-run-all2 dist release-sri release-zip",
    "release-sri": "node build/generate-sri.js",
    "release-version": "node build/change-version.js",
    "release-zip": "cross-env-shell \"rm -rf bootstrap-$npm_package_version-dist && cp -r dist/ bootstrap-$npm_package_version-dist && zip -r9 bootstrap-$npm_package_version-dist.zip bootstrap-$npm_package_version-dist && rm -rf bootstrap-$npm_package_version-dist\"",
    "dist": "npm-run-all2 --aggregate-output --parallel css js",
    "watch": "npm-run-all2 --parallel watch-css watch-js",
    "watch-css": "nodemon --watch scss/ --ext scss --exec \"npm-run-all2 css-lint css-compile css-prefix\"",
    "watch-js": "nodemon --watch js/src/ --ext js --exec \"npm-run-all2 js-lint js-compile\""
  },
  "peerDependencies": {
    "@popperjs/core": "^2.11.0",
    "jquery": ">=3.5 <5"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.49.1",
    "@popperjs/core": "^2.11.8",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@vitest/browser": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "babel-plugin-istanbul": "^7.0.0",
    "bundlewatch": "^0.4.0",
    "clean-css-cli": "^5.6.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.0",
    "eslint-config-xo": "^0.47.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "find-unused-sass-variables": "^5.0.0",
    "glob": "^11.0.0",
    "jquery": "^4.0.0",
    "jsdom": "^26.0.0",
    "lockfile-lint": "^4.14.0",
    "nodemon": "^3.1.0",
    "npm-run-all2": "^7.0.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.0",
    "postcss-cli": "^11.0.0",
    "rollup": "^4.34.0",
    "sass": "^1.79.0",
    "sinon": "^19.0.0",
    "sirv-cli": "^2.0.2",
    "stylelint": "^14.16.1",
    "stylelint-config-twbs-bootstrap": "^4.0.0",
    "terser": "^5.37.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist/{css,js}/*.{css,js,map}",
    "js/{src,dist}/**/*.{js,map}",
    "scss/**/*.scss"
  ],
  "engines": {
    "node": ">=22"
  }
}
